{
  "name": "sbodak/magento2-b2b-disable-add-to-cart-button-for-guest",
  "description": "This extension allows you to disable Add to cart button for guest. Useful feature for B2B store.",
  "keywords": ["magento2", "b2b", "disable Add to cart button"],
  "license": [
    "MIT"
  ],
  "type": "magento2-module",
  "version": "2.0.0",
  "authors": [
    {
      "name": "Slawomir Bodak",
      "email": "slawek.bodak@gmail.com"
    }
  ],
  "require": {
    "php": "~7.0|~7.1|~7.2|~7.3|~7.4|~8.0|~8.1|~8.2|~8.3|~8.4",
    "magento/framework": ">=103.0.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "files": [
      "src/registration.php"
    ],
    "psr-4": {
      "Bodak\\DisableAddToCart\\": "src/"
    }
  },
  "minimum-stability": "stable"
}
